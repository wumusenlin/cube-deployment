# Cube Core -> online MySQL
CUBEJS_DB_TYPE=mysql
CUBEJS_DB_HOST=mysql.example.com
CUBEJS_DB_PORT=3306
CUBEJS_DB_NAME=your_database
CUBEJS_DB_USER=your_username
CUBEJS_DB_PASS=your_password

# Enable this when the online MySQL service supports or requires SSL.
CUBEJS_DB_SSL=false

# Keep the initial connection/query concurrency conservative for an online DB.
CUBEJS_DB_MAX_POOL=8
CUBEJS_CONCURRENCY=2
CUBEJS_DB_QUERY_TIMEOUT=120

# Comma-separated organization IDs used by the scheduled refresh worker.
REFRESH_ORGANIZATION_IDS=200
